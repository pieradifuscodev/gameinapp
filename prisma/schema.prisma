datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String?   @unique
  bio                 String?
  password            String?
  name                String?
  surname             String?
  avatar              String?
  companyName         String?
  vatNumber           String?
  role                String    
  addressUser         String?
  latitude            Float?
  longitude           Float?
  favoriteSports      String[]  
  maxNotificationDist Int       @default(20) 
  emailVerified       DateTime?
  image               String?
  
  createdEvents       Event[]   @relation("EventCreator")
  participations      Event[]   @relation("EventParticipants")
  circles             Circle[]  @relation("CircleMembers")
  ownedCircles        Circle[]  @relation("CircleOwner")
  
  accounts            Account[]
  sessions            Session[]

  followedBy          User[]    @relation("UserFollows")
  following           User[]    @relation("UserFollows")
  notifications       Notification[]
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String
  sport        String   
  dateStart    DateTime
  location     String
  latitude     Float
  longitude    Float
  maxPlayers   Int
  status       String   
  isPrivate    Boolean  @default(false)
  
  creatorId    String
  creator      User     @relation("EventCreator", fields: [creatorId], references: [id])
  
  gymId        String?
  gym          Gym?     @relation(fields: [gymId], references: [id])
  
  circleId     String?
  circle       Circle?  @relation(fields: [circleId], references: [id])
  
  participants User[]   @relation("EventParticipants")
}

model Gym {
  id        String   @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  
  events    Event[]
}

model Circle {
  id        String   @id @default(uuid())
  name      String
  boardText String?
  
  ownerId   String
  owner     User     @relation("CircleOwner", fields: [ownerId], references: [id])
  
  members   User[]   @relation("CircleMembers")
  
  events    Event[]
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   
  title     String
  message   String
  link      String?  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
